{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd apps/api && npm install --legacy-peer-deps --ignore-scripts && npm run build"
  },
  "deploy": {
    "startCommand": "node --import tsx/esm apps/api/dist/src/index.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE"
  }
}
