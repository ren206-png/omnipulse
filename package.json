{
  "name": "omnipulse",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './apps/*' build",
    "typecheck": "pnpm --filter './apps/*' tsc --noEmit"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ],
    "overrides": {
      "proxy-addr": "2.0.8",
      "mysql2": "3.24.6",
      "fast-uri": "3.1.8",
      "http-cache-semantics": "4.3.0",
      "ip-address": "10.7.4",
      "postcss": "8.5.30",
      "deepmerge-ts": "8.0.2",
      "image-size": "2.0.4",
      "source-map-js": "1.2.2",
      "brace-expansion": "5.0.12",
      "browserslist": "4.29.3"
    }
  }
}
