{
  "name": "omnipulse",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './apps/*' build",
    "typecheck": "pnpm --filter './apps/*' tsc --noEmit"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ],
    "overrides": {
      "brace-expansion": ">=5.0.9",
      "fast-uri": ">=3.1.6",
      "@xmldom/xmldom": ">=0.9.12",
      "browserslist": ">=4.28.7",
      "deepmerge-ts": ">=8.0.0",
      "image-size": ">=2.0.3",
      "ip-address": ">=10.3.1",
      "js-yaml": ">=4.3.2",
      "mysql2": ">=3.22.0",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.18"
    }
  }
}
