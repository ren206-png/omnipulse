{
  "name": "omnipulse",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './apps/*' build",
    "typecheck": "pnpm --filter './apps/*' tsc --noEmit"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ],
    "overrides": {
      "fast-uri": ">=3.1.6",
      "ip-address": ">=10.3.1",
      "postcss": ">=8.5.18",
      "deepmerge-ts": ">=8.0.0",
      "mysql2": ">=3.22.0"
    }
  }
}
