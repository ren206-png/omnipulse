generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String
  role                 Role                  @default(MEMBER)
  createdAt            DateTime              @default(now())
  workspaces           Workspace[]
  workspaceMemberships WorkspaceMember[]
  notifications        Notification[]
  passwordResetToken   String?               @unique
  passwordResetExpires DateTime?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean               @default(false)
  twoFactorBackupCodes String[]
  passwordChangedAt    DateTime?
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id                     String               @id @default(cuid())
  name                   String
  ownerId                String
  owner                  User                 @relation(fields: [ownerId], references: [id])
  socialAccounts         SocialAccount[]
  posts                  ScheduledPost[]
  members                WorkspaceMember[]
  invitations            WorkspaceInvitation[]
  templates              ContentTemplate[]
  sharedReports          SharedReport[]
  bioPage                BioPage?
  inboxMessages          InboxMessage[]
  activityLogs           ActivityLog[]
  rssFeeds               RssFeed[]
  webhooks               WebhookEndpoint[]
  apiKeys                ApiKey[]
  clientPortal           ClientPortal?
  competitors            CompetitorAccount[]
  queueSlots             QueueSlot[]
  campaigns              Campaign[]
  mediaAssets            MediaAsset[]
  listeningKeywords      ListeningKeyword[]
  shortLinks             ShortLink[]
  plan                   Plan                 @default(FREE)
  stripeCustomerId       String?              @unique
  stripeSubscriptionId   String?              @unique
  subscriptionStatus     String?
  onboardingComplete     Boolean              @default(false)
  brandName              String?
  brandLogoUrl           String?
  brandColor             String?              @default("#6366f1")
  customDomain           String?              @unique
  seoMetadata         PostSeoMetadata[]
  postDlq             PostDlq[]
  tradeFlowMapping    TradeFlowTenantMapping?
  ingestedJobEvents   IngestedJobEvent[]
  postAttributions    PostAttribution[]
  attributionEvents   AttributionEvent[]
  approvalMagicLinks  ApprovalMagicLink[]
  branding            WorkspaceBranding?
  evergreenQueue      EvergreenQueue[]
  // Automation engine — additive, default off
  automationEnabled          Boolean                  @default(false)
  automationOptOutKeywords   String[]                 @default([])
  automationContacts         AutomationContact[]
  automationConversations    AutomationConversation[]
  automationFlows            AutomationFlow[]
  contactFlowInstances       ContactFlowInstance[]
  inboundAutomationEvents    InboundAutomationEvent[]
  automationOutbox           AutomationOutbox[]
}

enum Plan {
  FREE
  PRO
  AGENCY
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  @@unique([workspaceId, userId])
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique @default(cuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  CLIENT_APPROVER
}

model SocialAccount {
  id                String              @id @default(cuid())
  workspaceId       String
  workspace         Workspace           @relation(fields: [workspaceId], references: [id])
  platform          Platform
  accessToken       String
  refreshToken      String?
  tokenExpiresAt    DateTime?
  externalProfileId String
  // LinkedIn-specific: person URN and optional organization URNs (JSON array)
  linkedinPersonUrn          String?
  linkedinOrganizationUrns   Json?
  snapshots         AnalyticsSnapshot[]
  inboxMessages     InboxMessage[]

  @@index([workspaceId])
  @@index([workspaceId, platform])
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  X
  GOOGLE
  LINKEDIN
  YOUTUBE
}

model ScheduledPost {
  id                String      @id @default(cuid())
  workspaceId       String
  workspace         Workspace   @relation(fields: [workspaceId], references: [id])
  content           String
  mediaUrls         String[]
  platforms         Platform[]
  scheduledFor      DateTime
  status            PostStatus  @default(DRAFT)
  errorLog          String?
  responseLog       String?
  reviewNote        String?
  submittedBy       String?
  reviewedBy        String?
  createdAt         DateTime    @default(now())
  evergreen         Boolean     @default(false)
  evergreenInterval Int?
  evergreenParentId String?
  queuePosition     Int?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  firstComment      String?
  abVariantOf          String?
  abTestActive         Boolean     @default(false)
  // Recurring post fields
  recurrenceFreq       String?     // "daily" | "weekdays" | "weekly" | "monthly"
  recurrenceEndsAt     DateTime?   // stop creating new occurrences after this date (null = forever)
  recurrenceParentId   String?     // id of the original post this was spawned from
  metrics              PostMetric[]
  platformVariants     PlatformVariant[]
  comments             PostComment[]
  campaignId           String?
  campaign             Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  seoMetadata         PostSeoMetadata?
  attribution         PostAttribution?
  evergreenQueue      EvergreenQueue?

  @@index([status, scheduledFor])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, scheduledFor])
}

model PostComment {
  id        String        @id @default(cuid())
  postId    String
  post      ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  userEmail String
  body      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId])
}

model PlatformVariant {
  id        String        @id @default(cuid())
  postId    String
  post      ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform  Platform
  content   String
  hashtags  String[]
  mediaUrls String[]
  altText             String?
  createdAt DateTime      @default(now())

  @@unique([postId, platform])
}

model PostMetric {
  id           String        @id @default(cuid())
  postId       String
  post         ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform     Platform
  likes        Int           @default(0)
  comments     Int           @default(0)
  shares       Int           @default(0)
  reach        Int           @default(0)
  impressions  Int           @default(0)
  recordedAt   DateTime      @default(now())

  @@unique([postId, platform])
  @@index([postId])
}

enum PostStatus {
  DRAFT
  QUEUED
  PENDING_REVIEW
  APPROVED
  SCHEDULED
  PROCESSING
  PUBLISHED
  FAILED
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, read])
}

model SharedReport {
  id          String    @id @default(cuid())
  token       String    @unique @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  label       String?
  startDate   String?
  endDate     String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String

  @@index([workspaceId])
}

model ContentTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  content     String
  platforms   Platform[]
  category    String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, category])
}

model AnalyticsSnapshot {
  id              String        @id @default(cuid())
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])
  followers       Int
  impressions     Int
  engagementRate  Float
  recordedAt      DateTime      @default(now())

  @@index([socialAccountId, recordedAt])
}

model InboxMessage {
  id              String             @id @default(cuid())
  workspaceId     String
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount      @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  platform        Platform
  externalId      String
  authorName      String
  authorHandle    String?
  content         String
  type            InboxMessageType   @default(COMMENT)
  status          InboxMessageStatus @default(UNREAD)
  reply           String?
  repliedAt       DateTime?
  createdAt       DateTime           @default(now())

  @@unique([socialAccountId, externalId])
  @@index([workspaceId, status])
}

enum InboxMessageType {
  COMMENT
  MENTION
  DM
}

enum InboxMessageStatus {
  UNREAD
  READ
  REPLIED
  DISMISSED
}

model BioPage {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug        String    @unique
  title       String
  bio         String?
  avatarUrl   String?
  theme       String    @default("light")
  views       Int       @default(0)
  links       BioLink[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BioLink {
  id        String   @id @default(cuid())
  bioPageId String
  bioPage   BioPage  @relation(fields: [bioPageId], references: [id], onDelete: Cascade)
  title     String
  url       String
  icon      String?
  clicks    Int      @default(0)
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  userEmail   String
  action      String
  targetId    String?
  targetType  String?
  details     String?
  createdAt   DateTime  @default(now())
  @@index([workspaceId, createdAt])
}

model RssFeed {
  id            String     @id @default(cuid())
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url           String
  name          String
  platforms     Platform[]
  active        Boolean    @default(true)
  checkInterval Int        @default(60)
  lastCheckedAt DateTime?
  lastItemGuid  String?
  createdAt     DateTime   @default(now())
  @@unique([workspaceId, url])
}

model WebhookEndpoint {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url         String
  secret      String
  events      String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@index([workspaceId])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  @@index([workspaceId])
}

model ClientPortal {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  token       String    @unique @default(cuid())
  clientName  String?
  clientEmail String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CompetitorAccount {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform    Platform
  handle      String
  displayName String?
  snapshots   CompetitorSnapshot[]
  createdAt   DateTime  @default(now())
  @@unique([workspaceId, platform, handle])
}

model CompetitorSnapshot {
  id                  String             @id @default(cuid())
  competitorAccountId String
  competitorAccount   CompetitorAccount  @relation(fields: [competitorAccountId], references: [id], onDelete: Cascade)
  followers           Int                @default(0)
  estimatedEngagement Float              @default(0)
  source              String             @default("ESTIMATED")
  recordedAt          DateTime           @default(now())
  @@index([competitorAccountId, recordedAt])
}

model QueueSlot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dayOfWeek   Int       // 0=Sunday … 6=Saturday
  timeOfDay   String    // "HH:MM" 24-hour
  timezone    String    // IANA timezone string e.g. "America/New_York"
  platform    Platform? // optional — null means applies to all platforms
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, isActive])
}

model Campaign {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String          @default("#6366f1")
  posts       ScheduledPost[]
  createdAt   DateTime        @default(now())

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ListeningKeyword {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  keyword     String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, keyword])
  @@index([workspaceId])
}

model MediaAsset {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url         String
  filename    String
  mimeType    String
  size        Int       @default(0)
  tags        String[]
  altText             String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model ShortLink {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  originalUrl String
  slug        String    @unique
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model PostDlq {
  id            String    @id @default(cuid())
  workspaceId   String
  postId        String
  platform      String
  errorCode     Int?
  errorMessage  String
  attempts      Int       @default(1)
  lastAttemptAt DateTime  @default(now())
  resolvedAt    DateTime?
  resolvedBy    String?
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([postId])
  @@index([resolvedAt])
}

model PostSeoMetadata {
  id              String        @id @default(cuid())
  postId          String        @unique
  post            ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metaTitle       String?
  metaDescription String?
  ogTitle         String?
  ogDescription   String?
  ogType          String?
  ogImageUrl      String?
  keywords        String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workspaceId])
}

model TradeFlowTenantMapping {
  id                  String    @id @default(cuid())
  workspaceId         String    @unique
  tradeFlowAccountId  String    @unique
  linkedAt            DateTime  @default(now())
  linkedBy            String    // userId who created the link
  active              Boolean   @default(true)
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([tradeFlowAccountId])
}

model IngestedJobEvent {
  id                  String    @id @default(cuid())
  workspaceId         String
  tradeFlowAccountId  String
  eventType           String    // 'job.booked' | 'job.completed'
  jobId               String
  jobType             String?
  city                String?
  rawPayload          Json
  nonce               String    @unique  // replay protection
  receivedAt          DateTime  @default(now())
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
  @@index([jobId])
  @@index([nonce])
}

model PostAttribution {
  id              String        @id @default(cuid())
  postId          String
  workspaceId     String
  trackedNumber   String?       // Twilio/provider phone number (nullable — UTM-only attribution)
  utmTag          String?       // UTM campaign tag for link-based attribution
  callsReceived   Int           @default(0)
  bookingsCreated Int           @default(0)
  lastUpdatedAt   DateTime      @default(now())
  createdAt       DateTime      @default(now())
  post            ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([postId])
  @@index([workspaceId])
  @@index([trackedNumber])
  @@index([utmTag])
}

model AttributionEvent {
  id            String    @id @default(cuid())
  postId        String
  workspaceId   String
  eventType     String    // 'call' | 'booking'
  source        String    // 'phone' | 'utm_link'
  metadata      Json?     // raw event data from TradeFlow/Twilio adapter
  receivedAt    DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([postId])
  @@index([workspaceId])
}

model ApprovalMagicLink {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique @default(cuid())
  email       String
  createdBy   String
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
  @@index([token])
}

model WorkspaceBranding {
  id           String    @id @default(cuid())
  workspaceId  String    @unique
  logoUrl      String?
  primaryColor String    @default("#6366f1")
  companyName  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model EvergreenQueue {
  id                  String        @id @default(cuid())
  workspaceId         String
  postId              String        @unique  // the original evergreen post
  minIntervalDays     Int           @default(45)
  lastRecycledAt      DateTime?
  nextRecycleAfter    DateTime?     // computed: lastRecycledAt + minIntervalDays
  autoPublish         Boolean       @default(false)  // explicit opt-in, off by default
  seasonalExclusions  Json?         // array of { startMD: "12-20", endMD: "01-05", label: "Christmas" }
  active              Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  workspace           Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post                ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
  @@index([nextRecycleAfter, active])
}

// ─── AUTOMATION ENGINE ────────────────────────────────────────────────────────
// Engine-owned models. "tenantId" in the spec = workspaceId here.
// Feature-gated by Workspace.automationEnabled + AUTOMATION_ENGINE_ENABLED env.
// All models are additive — no existing model, field, or enum is altered.

enum AutomationChannel {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  STUB
}

enum AutomationFlowStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum AutomationFlowVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum AutomationTriggerType {
  KEYWORD
  FIRST_CONTACT
  ANY_MESSAGE
  WEBHOOK_EVENT
}

enum AutomationNodeType {
  MESSAGE
  CONDITION
  ACTION
  WAIT
  END
}

enum AutomationReentryPolicy {
  IGNORE
  RESTART
  ALLOW_PARALLEL
}

enum ContactFlowInstanceStatus {
  RUNNING
  WAITING_FOR_INPUT
  WAITING_UNTIL
  COMPLETED
  FAILED
  CANCELLED
}

enum AutomationEventProcessingStatus {
  PENDING
  PROCESSED
  IGNORED
  FAILED
}

enum AutomationOutboxStatus {
  PENDING
  CLAIMED
  SENT
  FAILED
  WINDOW_CLOSED
  DEAD
}

// Engine-owned contact identity — not a general CRM contact.
model AutomationContact {
  id                   String             @id @default(cuid())
  workspaceId          String
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  channel              AutomationChannel
  channelUserId        String
  displayName          String?
  automationOptedOut   Boolean            @default(false)
  automationOptedOutAt DateTime?
  automationFields     Json?
  firstSeenAt          DateTime           @default(now())
  lastSeenAt           DateTime           @default(now())

  conversations AutomationConversation[]
  instances     ContactFlowInstance[]
  inboundEvents InboundAutomationEvent[]

  @@unique([workspaceId, channel, channelUserId])
  @@index([workspaceId, channel])
  @@index([workspaceId, automationOptedOut])
  @@map("automation_contacts")
}

// Engine-owned conversation thread.
model AutomationConversation {
  id                     String            @id @default(cuid())
  workspaceId            String
  workspace              Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  contactId              String
  contact                AutomationContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel                AutomationChannel
  providerConversationId String?
  startedAt              DateTime          @default(now())
  lastMessageAt          DateTime          @default(now())

  instances     ContactFlowInstance[]
  inboundEvents InboundAutomationEvent[]

  @@index([workspaceId])
  @@index([contactId])
  @@index([workspaceId, channel, providerConversationId])
  @@map("automation_conversations")
}

// Flow definition (metadata only; graph lives in versions).
model AutomationFlow {
  id                             String                  @id @default(cuid())
  workspaceId                    String
  workspace                      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name                           String
  description                    String?
  status                         AutomationFlowStatus    @default(DRAFT)
  priority                       Int                     @default(0)
  reentryPolicy                  AutomationReentryPolicy @default(IGNORE)
  maxParallelInstancesPerContact Int                     @default(3)
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt
  createdBy                      String?

  versions  AutomationFlowVersion[]
  instances ContactFlowInstance[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@map("automation_flows")
}

// Immutable once PUBLISHED. Exactly one DRAFT per flow.
model AutomationFlowVersion {
  id            String                      @id @default(cuid())
  flowId        String
  flow          AutomationFlow              @relation(fields: [flowId], references: [id], onDelete: Cascade)
  version       Int
  status        AutomationFlowVersionStatus @default(DRAFT)
  triggerType   AutomationTriggerType
  triggerConfig Json
  entryNodeKey  String
  graphHash     String
  publishedAt   DateTime?
  publishedBy   String?
  revision      Int                         @default(0)

  nodes     FlowNode[]
  edges     FlowEdge[]
  instances ContactFlowInstance[]

  @@unique([flowId, version])
  @@index([flowId, status])
  @@map("automation_flow_versions")
}

// Graph node — immutable once version is PUBLISHED.
model FlowNode {
  id            String                @id @default(cuid())
  flowVersionId String
  flowVersion   AutomationFlowVersion @relation(fields: [flowVersionId], references: [id], onDelete: Cascade)
  nodeKey       String
  nodeType      AutomationNodeType
  config        Json
  uiMeta        Json?

  outgoingEdges FlowEdge[]      @relation("EdgeSource")
  incomingEdges FlowEdge[]      @relation("EdgeTarget")
  executions    NodeExecution[]

  @@unique([flowVersionId, nodeKey])
  @@index([flowVersionId])
  @@map("flow_nodes")
}

// Graph edge — immutable once version is PUBLISHED.
model FlowEdge {
  id            String                @id @default(cuid())
  flowVersionId String
  flowVersion   AutomationFlowVersion @relation(fields: [flowVersionId], references: [id], onDelete: Cascade)
  sourceNodeId  String
  sourceNode    FlowNode              @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNodeId  String
  targetNode    FlowNode              @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)
  label         String
  priority      Int?

  @@unique([sourceNodeId, label])
  @@index([flowVersionId])
  @@map("flow_edges")
}

// Per-contact flow execution instance.
model ContactFlowInstance {
  id             String                    @id @default(cuid())
  workspaceId    String
  workspace      Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  contactId      String
  contact        AutomationContact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   AutomationConversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  flowId         String
  flow           AutomationFlow            @relation(fields: [flowId], references: [id], onDelete: Restrict)
  flowVersionId  String
  flowVersion    AutomationFlowVersion     @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  currentNodeId  String?
  status         ContactFlowInstanceStatus @default(RUNNING)
  context        Json                      @default("{}")
  wakeAt         DateTime?
  expiresAt      DateTime?
  startedAt      DateTime                  @default(now())
  completedAt    DateTime?
  lastEventAt    DateTime                  @default(now())
  failureReason  String?
  revision       Int                       @default(0)

  nodeExecutions NodeExecution[]

  @@index([workspaceId, contactId, status])
  @@index([status, wakeAt])
  @@index([status, expiresAt])
  @@index([workspaceId, flowVersionId])
  @@map("contact_flow_instances")
}

// Immutable inbound event record.
model InboundAutomationEvent {
  id                 String                          @id @default(cuid())
  workspaceId        String
  workspace          Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  channel            AutomationChannel
  providerEventId    String?
  idempotencyKey     String
  derivedIdempotency Boolean                         @default(false)
  senderId           String
  contactId          String?
  contact            AutomationContact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversationId     String?
  conversation       AutomationConversation?         @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  text               String?
  normalizedText     String?
  quickReplyValue    String?
  payload            Json
  receivedAt         DateTime                        @default(now())
  processingStatus   AutomationEventProcessingStatus @default(PENDING)
  processingError    String?

  nodeExecutions NodeExecution[]

  @@unique([workspaceId, channel, idempotencyKey])
  @@index([workspaceId, processingStatus])
  @@map("inbound_automation_events")
}

// Per-node execution record (idempotent via unique idempotencyKey).
model NodeExecution {
  id             String                  @id @default(cuid())
  instanceId     String
  instance       ContactFlowInstance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  nodeId         String
  node           FlowNode                @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  inboundEventId String?
  inboundEvent   InboundAutomationEvent? @relation(fields: [inboundEventId], references: [id], onDelete: SetNull)
  attempt        Int                     @default(1)
  status         String
  startedAt      DateTime                @default(now())
  finishedAt     DateTime?
  idempotencyKey String                  @unique
  result         Json?
  error          Json?

  @@index([instanceId])
  @@map("node_executions")
}

// Outbox pattern for every externally-visible side effect.
model AutomationOutbox {
  id             String                 @id @default(cuid())
  workspaceId    String
  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  instanceId     String?
  type           String
  payload        Json
  idempotencyKey String                 @unique
  status         AutomationOutboxStatus @default(PENDING)
  attempts       Int                    @default(0)
  nextAttemptAt  DateTime               @default(now())
  claimedBy      String?
  claimedAt      DateTime?
  lastError      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, nextAttemptAt])
  @@index([workspaceId])
  @@map("automation_outbox")
}
